"use client";

import {
  ArrowRight,
  BarChart3,
  Bot,
  Check,
  Code2,
  FileCheck2,
  Globe2,
  SearchCheck,
  Store,
} from "lucide-react";
import Link from "next/link";
import { useEffect, useRef, useState } from "react";

import { PublicFooter } from "@/components/public/public-footer";

const processSteps = [
  {
    number: "01",
    title: "Create your business profile",
    description:
      "Add the important information customers need, including your business name, contacts, description, category and website.",
    details: [
      "Business identity",
      "Contact information",
      "Business type",
      "Website and social links",
    ],
    icon: Store,
  },
  {
    number: "02",
    title: "Add locations and offerings",
    description:
      "Tell Vizo where your business operates and what products or services customers can find there.",
    details: [
      "Business locations",
      "Opening hours",
      "Services and products",
      "Prices and availability",
    ],
    icon: SearchCheck,
  },
  {
    number: "03",
    title: "Connect your website",
    description:
      "Install one small Vizo script on your existing website. You do not need to replace or rebuild the website.",
    details: [
      "One-line installation",
      "Works with existing websites",
      "Automatic information updates",
      "Installation verification",
    ],
    icon: Code2,
  },
  {
    number: "04",
    title: "Publish verified information",
    description:
      "Vizo prepares your information in formats that search engines, maps and AI systems can understand.",
    details: [
      "Schema.org structured data",
      "AI-readable business information",
      "Search and GEO signals",
      "Consistent business details",
    ],
    icon: FileCheck2,
  },
  {
    number: "05",
    title: "Measure and improve",
    description:
      "Monitor your visibility score, discover missing information and receive clear recommendations.",
    details: [
      "Visibility audit",
      "AI-readiness score",
      "Website monitoring",
      "Improvement recommendations",
    ],
    icon: BarChart3,
  },
];

const results = [
  {
    title: "Search visibility",
    description:
      "Help customers find accurate information through traditional search.",
    icon: Globe2,
  },
  {
    title: "AI discovery",
    description:
      "Prepare your business to appear in AI-generated recommendations.",
    icon: Bot,
  },
  {
    title: "Trusted information",
    description:
      "Keep locations, hours, services and contact information consistent.",
    icon: FileCheck2,
  },
];

export default function HowItWorksPage() {
  const processRef = useRef<HTMLElement>(null);
  const [visible, setVisible] = useState(false);
  const [copied, setCopied] = useState(false);

  const installationCode =
    '<script src="https://www.vizo.asyncafrica.com/connect.js?site_id=YOUR_SITE_ID"></script>';

  useEffect(() => {
    const section = processRef.current;

    if (!section) {
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setVisible(true);
          observer.disconnect();
        }
      },
      { threshold: 0.08 },
    );

    observer.observe(section);

    return () => observer.disconnect();
  }, []);

  async function copyCode() {
    await navigator.clipboard.writeText(installationCode);
    setCopied(true);

    window.setTimeout(() => {
      setCopied(false);
    }, 2000);
  }

  return (
    <main className="bg-white">
      <section className="relative overflow-hidden bg-[#07152b] px-5 pb-20 pt-36 text-white sm:px-8 lg:px-12 lg:pb-24">
        <div className="absolute -right-40 top-16 size-[500px] rounded-full bg-teal-400/10 blur-3xl" />
        <div className="absolute -left-40 bottom-0 size-96 rounded-full bg-blue-500/10 blur-3xl" />

        <div className="relative mx-auto max-w-[1200px] text-center">
          <p className="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-bold text-teal-300">
            <Bot className="size-4" />
            From business information to better visibility
          </p>

          <h1 className="mx-auto mt-6 max-w-4xl text-4xl font-black leading-[1.04] tracking-[-0.05em] sm:text-5xl lg:text-7xl">
            How Vizo makes your business easier to discover.
          </h1>

          <p className="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
            Create one reliable source of business information, connect your
            website and publish details that customers, search engines and AI
            platforms can understand.
          </p>

          <div className="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
            <Link
              href="/register"
              className="group inline-flex h-12 items-center justify-center gap-3 rounded-full bg-teal-400 px-7 text-sm font-black text-slate-950 transition hover:bg-teal-300"
            >
              Get started
              <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" />
            </Link>

            <Link
              href="/audit"
              className="inline-flex h-12 items-center justify-center rounded-full border border-white/25 bg-white/10 px-7 text-sm font-black text-white transition hover:bg-white/20"
            >
              Audit your business
            </Link>
          </div>
        </div>
      </section>

      <section
        ref={processRef}
        className="px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24"
      >
        <div className="mx-auto max-w-[1200px]">
          <div className="max-w-2xl">
            <p className="text-sm font-black uppercase tracking-[0.2em] text-teal-700">
              The Vizo process
            </p>

            <h2 className="mt-4 text-3xl font-black tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">
              Five steps from setup to measurable results.
            </h2>
          </div>

          <div className="mt-12 space-y-5">
            {processSteps.map((step, index) => {
              const Icon = step.icon;

              return (
                <article
                  key={step.number}
                  className={`grid overflow-hidden rounded-3xl border border-slate-200 bg-white transition-all duration-700 hover:border-teal-200 hover:shadow-xl hover:shadow-slate-900/5 lg:grid-cols-[0.8fr_1.2fr] ${
                    visible
                      ? "translate-y-0 opacity-100"
                      : "translate-y-10 opacity-0"
                  }`}
                  style={{
                    transitionDelay: visible ? `${index * 120}ms` : "0ms",
                  }}
                >
                  <div
                    className={`p-6 sm:p-8 ${
                      index % 2 === 0
                        ? "bg-slate-950 text-white"
                        : "bg-teal-500 text-slate-950"
                    }`}
                  >
                    <div className="flex items-center justify-between">
                      <span
                        className={`grid size-12 place-items-center rounded-2xl ${
                          index % 2 === 0
                            ? "bg-white/10 text-teal-300"
                            : "bg-white/30 text-slate-950"
                        }`}
                      >
                        <Icon className="size-5" />
                      </span>

                      <span
                        className={`text-5xl font-black ${
                          index % 2 === 0
                            ? "text-white/10"
                            : "text-slate-950/15"
                        }`}
                      >
                        {step.number}
                      </span>
                    </div>

                    <h3 className="mt-8 text-2xl font-black tracking-[-0.03em] sm:text-3xl">
                      {step.title}
                    </h3>

                    <p
                      className={`mt-4 text-sm leading-7 ${
                        index % 2 === 0 ? "text-slate-300" : "text-slate-800"
                      }`}
                    >
                      {step.description}
                    </p>
                  </div>

                  <div className="grid gap-3 p-6 sm:grid-cols-2 sm:p-8">
                    {step.details.map((detail) => (
                      <div
                        key={detail}
                        className="flex items-center gap-3 rounded-2xl bg-slate-50 p-4"
                      >
                        <span className="grid size-7 shrink-0 place-items-center rounded-full bg-teal-100 text-teal-700">
                          <Check className="size-4" strokeWidth={3} />
                        </span>

                        <p className="text-sm font-bold text-slate-800">
                          {detail}
                        </p>
                      </div>
                    ))}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section className="bg-[#f3f6f8] px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
        <div className="mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-2">
          <div>
            <p className="text-sm font-black uppercase tracking-[0.2em] text-teal-700">
              Website Connect
            </p>

            <h2 className="mt-4 text-3xl font-black tracking-[-0.04em] text-slate-950 sm:text-4xl">
              Connect Vizo without replacing your website.
            </h2>

            <p className="mt-5 text-base leading-8 text-slate-600">
              The Vizo Connect script publishes verified information from your
              Vizo profile to your website. Changes can be managed from one
              place without manually editing every page.
            </p>

            <ul className="mt-7 space-y-3">
              {[
                "Works with most websites",
                "Does not change the existing design",
                "Keeps published information synchronized",
                "Can be removed at any time",
              ].map((item) => (
                <li
                  key={item}
                  className="flex items-center gap-3 text-sm font-bold text-slate-800"
                >
                  <Check className="size-4 text-teal-600" strokeWidth={3} />
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div className="overflow-hidden rounded-3xl bg-[#07152b] shadow-2xl shadow-slate-900/15">
            <div className="flex items-center justify-between border-b border-white/10 px-5 py-4">
              <div className="flex gap-2">
                <span className="size-2.5 rounded-full bg-rose-400" />
                <span className="size-2.5 rounded-full bg-amber-400" />
                <span className="size-2.5 rounded-full bg-teal-400" />
              </div>

              <span className="text-xs font-bold text-slate-400">
                Website installation
              </span>
            </div>

            <div className="p-5 sm:p-7">
              <p className="text-xs font-black uppercase tracking-wider text-teal-300">
                Add before the closing body tag
              </p>

              <pre className="mt-4 overflow-x-auto rounded-2xl bg-black/30 p-5 text-sm leading-7 text-slate-200">
                <code>{installationCode}</code>
              </pre>

              <button
                type="button"
                onClick={copyCode}
                className="mt-5 inline-flex h-11 items-center justify-center rounded-full bg-teal-400 px-6 text-sm font-black text-slate-950 transition hover:bg-teal-300"
              >
                {copied ? "Copied" : "Copy installation code"}
              </button>
            </div>
          </div>
        </div>
      </section>

      <section className="px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
        <div className="mx-auto max-w-[1200px]">
          <div className="grid gap-4 md:grid-cols-3">
            {results.map((result) => {
              const Icon = result.icon;

              return (
                <article
                  key={result.title}
                  className="rounded-3xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/5 sm:p-7"
                >
                  <span className="grid size-11 place-items-center rounded-2xl bg-slate-950 text-teal-300">
                    <Icon className="size-5" />
                  </span>

                  <h3 className="mt-6 text-xl font-black text-slate-950">
                    {result.title}
                  </h3>

                  <p className="mt-3 text-sm leading-7 text-slate-600">
                    {result.description}
                  </p>
                </article>
              );
            })}
          </div>

          <div className="mt-10 flex flex-col gap-6 rounded-[30px] bg-teal-400 p-7 sm:flex-row sm:items-center sm:justify-between sm:p-10">
            <div>
              <h2 className="text-2xl font-black tracking-[-0.03em] text-slate-950 sm:text-3xl">
                Ready to improve your business visibility?
              </h2>

              <p className="mt-2 text-sm text-slate-800">
                Create your business profile and receive your first visibility
                score.
              </p>
            </div>

            <Link
              href="/register"
              className="group inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-full bg-slate-950 px-7 text-sm font-black text-white"
            >
              Create your profile
              <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" />
            </Link>
          </div>
        </div>
      </section>

      <PublicFooter />
    </main>
  );
}
